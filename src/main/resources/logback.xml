<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="com.github.devapro.pttdroid.server" level="DEBUG"/>
    <logger name="ChannelRoutes" level="DEBUG"/>
    <!-- Netty and Ktor are chatty at DEBUG and would bury the session/floor logs. -->
    <logger name="io.netty" level="WARN"/>
    <logger name="io.ktor" level="INFO"/>
</configuration>
