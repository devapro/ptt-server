# /etc/ptt-server.env — read by deploy/ptt-server.service.
# systemd parses this itself: no quotes, no shell expansion, one KEY=value per line.

PTT_HOST=0.0.0.0
PTT_PORT=8000
PTT_MAX_CHANNEL=99
PTT_MAX_SESSIONS_PER_CHANNEL=32

# Shared secret every client sends in the X-PTT-Token header. Generate: openssl rand -base64 24
PTT_AUTH_TOKEN=

# --- TLS with a self-signed certificate ------------------------------------------------------
# The keystore is generated on first boot and reused after that, so the fingerprint clients
# pin stays stable. Print it with: cat /opt/ptt-server/certs/ptt.p12.sha256
PTT_TLS_ENABLED=false
PTT_HTTP_ENABLED=true
PTT_TLS_PORT=8443
PTT_TLS_KEYSTORE=/opt/ptt-server/certs/ptt.p12
PTT_TLS_KEYSTORE_PASSWORD=
PTT_TLS_SAN=localhost,127.0.0.1

# Set only when a reverse proxy in front of this actually rewrites X-Forwarded-*; otherwise a
# client can forge them.
PTT_TRUST_FORWARDED_HEADERS=false
