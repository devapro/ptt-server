# Copy to .env next to docker-compose.yml. Compose reads it automatically.
# Nothing here has a sensible universal default, which is why none of it is baked into an image.

# ---- relay ---------------------------------------------------------------------------------
# Host interface the published port binds to. 0.0.0.0 is every interface; use 127.0.0.1 to
# reach the relay only from the machine itself (e.g. when a reverse proxy fronts it).
PTT_BIND=0.0.0.0
PTT_PORT=8000
PTT_MAX_CHANNEL=99
PTT_MAX_SESSIONS_PER_CHANNEL=32

# Shared secret every client must send in the X-PTT-Token header. Leave blank ONLY on a LAN
# you control — an open relay is a listening device. Generate one with:
#   openssl rand -base64 24
PTT_AUTH_TOKEN=

# ---- TLS (docker-compose.tls.yml) ----------------------------------------------------------
# A self-signed certificate is generated into the ptt-certs volume on first boot and reused
# afterwards. Clients trust it by SHA-256 fingerprint; print it with ./deploy/fingerprint.sh
PTT_TLS_PORT=8443
PTT_TLS_KEYSTORE_PASSWORD=
# Names and addresses to issue the certificate for. Fingerprint pinning ignores these, but
# curl and browsers do not. Add your LAN IP or hostname.
PTT_TLS_SAN=localhost,127.0.0.1
PTT_TLS_VALIDITY_DAYS=3650

# ---- ngrok (docker-compose.ngrok.yml) ------------------------------------------------------
# From https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional reserved domain, so the public address survives a restart. Leave blank for a
# random one each time.
NGROK_DOMAIN=

# ---- deploy/deploy.sh ----------------------------------------------------------------------
PTT_DEPLOY_HOST=
PTT_DEPLOY_USER=
PTT_DEPLOY_DIR=/opt/ptt-server
PTT_DEPLOY_SSH_PORT=22
# Which compose files the remote host brings up. Space-separated, in overlay order.
PTT_DEPLOY_COMPOSE_FILES=docker-compose.yml
